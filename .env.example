# NeoAgent Configuration
# Copy to .env and customize: cp .env.example .env

# ── Default LLM (Deepseek-first) ─────────────────
DEFAULT_PROVIDER=deepseek        # deepseek | openai | anthropic | ollama | groq | google | aliyun
DEFAULT_MODEL=deepseek-v4-pro
TEMPERATURE=0.0
MAX_TOKENS=4096

# ── API Keys ─────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-key
GROQ_API_KEY=gsk_your-groq-key
TAVILY_API_KEY=tvly-your-tavily-key

# ── Custom Base URLs (optional) ──────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OLLAMA_BASE_URL=http://localhost:11434

# ── Smart Router ─────────────────────────────────
ROUTER_ENABLED=true
CHEAP_MODEL=deepseek-chat        # Same-provider cheap model for summarization
POWERFUL_MODEL=deepseek-v4-pro   # Best model for complex reasoning

# ── Token Budget (per session) ───────────────────
BUDGET_MAX_INPUT_TOKENS=100000
BUDGET_MAX_OUTPUT_TOKENS=50000
BUDGET_MAX_COST_USD=5.00

# ── Memory ───────────────────────────────────────
MEMORY_SHORT_TERM_TURNS=20       # Recent message turns to keep in context
MEMORY_LONG_TERM_ENABLED=true    # Enable ChromaDB vector memory
MEMORY_CONSOLIDATION_INTERVAL=10 # Consolidate old messages every N turns

# ── Security / Sandbox ───────────────────────────
SANDBOX_MODE=docker              # docker | process | none
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_NETWORK_ENABLED=false

# ── Server ───────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
SERVER_CORS_ORIGINS=*               # Comma-separated list, e.g. "http://localhost:3000,https://app.example.com"
API_KEY=                            # Optional Bearer token for API/WebSocket protection

# ── Workspace & Enterprise Skill Library ─────────
NEOAGENT_WORKSPACE=./workspace
# Path to enterprise SKILL.md library (auto-discovers ../skill if sibling directory exists)
# NEOAGENT_SKILL_REPO=../skill
# NEOAGENT_DEVOPS_CONFIG=./devops.toml
